# Dart / Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/

# The lockfile is deliberately not committed so CI resolves against whatever
# Flutter stable is on the runner.
pubspec.lock

# Platform folders are generated by the CI workflow (and by `flutter create .`
# locally), so they are deliberately not committed. Committing a partial
# android/ folder is worse than having none at all.
android/
ios/
macos/
windows/
linux/

# Misc
*.log
.DS_Store
